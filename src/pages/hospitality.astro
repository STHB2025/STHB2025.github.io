---
import BaseLayout from '../components/BaseLayout.astro';
import { experience, profile } from '../data/site';
import { sitePath } from '../utils/site-path';
const hospitalityExperience = experience.filter((job) => job.company !== 'KP Prop');
const gigEnquiry = `mailto:${profile.email}?subject=${encodeURIComponent('Hospitality and event services enquiry')}&body=${encodeURIComponent('Hi Jackson,\n\nI would like to enquire about your availability for a hospitality shift, private function or event.\n\nEvent or role:\nDate and time:\nLocation:\n\nThank you.')}`;
---
<BaseLayout title="Hospitality & Event Services — Jackson" description="More than 16 years in hospitality and operations. Available for part-time opportunities, private functions and events." active="/hospitality/">
  <section class="page-hero hospitality-hero"><div class="page-hero-copy"><span class="eyebrow">HOSPITALITY · THE OPERATIONAL FOUNDATION</span><h1>Service is a<br/><em>way of thinking.</em></h1><p>More than 16 years across hotels, luxury hospitality, restaurants, bars, cafés, concierge, guest relations and operations.</p></div><div class="hospitality-art"><div class="hospitality-profile-mark" aria-hidden="true"><span>PEOPLE</span><i>DETAIL · SERVICE · CARE</i><span>EXPERIENCE</span></div><figure class="hospitality-profile"><img src={sitePath('/images/jackson/portrait.webp')} alt="Portrait of Jackson wearing a navy suit and glasses" loading="eager" decoding="async" /><figcaption>Innocent Jackson</figcaption></figure></div></section>
  <section class="section hospitality-services" aria-labelledby="hospitality-services-title"><div class="hospitality-services-copy"><span class="eyebrow">HOSPITALITY & EVENT SERVICES</span><h2 id="hospitality-services-title">Experienced service,<br/><em>ready when needed.</em></h2><p>Alongside my business and technology interests, I remain active in hospitality. With hands-on experience in bartending, beverage service, guest relations and front-of-house operations, I am available for part-time shifts, private bartender bookings, weddings and private events, corporate functions and special occasions.</p><a class="button button-dark" href={gigEnquiry}>Enquire About a Private Gig <span>↗</span></a></div><ul class="hospitality-service-list"><li>Private bartender bookings</li><li>Weddings and private events</li><li>Corporate functions</li><li>Front-of-house hospitality support</li><li>Guest relations and customer experience</li></ul></section>
  <section class="hospitality-statement"><span>WHAT THE WORK TAUGHT ME</span><p>Notice the detail.<br/>Stay calm under pressure.<br/><em>Make the experience work.</em></p><a href={sitePath('/work/senior-tech-hub/')} class="text-link">See how that carries forward <i>↗</i></a></section>
  <section class="section experience-section"><div class="section-heading"><div><span class="eyebrow">EXPERIENCE · 2007—2025</span><h2>Built on the<br/><em>real work.</em></h2></div><p>Guest experience, operational discipline and practical problem-solving across service environments.</p></div><div class="timeline">{hospitalityExperience.map((job, i) => <article class="timeline-item"><span class="timeline-number">{String(i + 1).padStart(2, '0')}</span><div><h3>{job.role}</h3><span class="timeline-company">{job.company}</span><p>{job.detail}</p></div><time>{job.dates}</time></article>)}</div></section>
</BaseLayout>

<style>
  .hospitality-art { display: flex; align-items: center; justify-content: center; min-width: 0; }
  .hospitality-profile-mark { position: absolute; inset: auto; width: min(310px, 82%); aspect-ratio: 1; border: 1px solid rgba(52, 84, 72, .13); border-radius: 50%; background: radial-gradient(circle, rgba(223, 229, 217, .9), rgba(233, 230, 222, .45) 72%); }
  .hospitality-profile-mark span, .hospitality-profile-mark i { display: none; }
  .hospitality-profile { position: relative; z-index: 1; width: clamp(174px, 18vw, 230px); height: clamp(260px, 21vw, 300px); margin: 0; display: flex; align-items: center; justify-content: center; overflow: visible; border: 0; border-radius: 0; background: transparent; box-shadow: none; }
  .hospitality-profile img { display: block; width: 100%; height: 100%; object-fit: contain; object-position: center bottom; }
  .hospitality-profile figcaption { position: absolute; right: -8px; bottom: 2px; padding: 5px 10px; border-radius: 999px; background: var(--green); color: #fff; font: 8px var(--mono); letter-spacing: .06em; }
  .hospitality-services { display: grid; grid-template-columns: 1.2fr .8fr; align-items: center; gap: clamp(32px, 7vw, 96px); background: #f4f1eb; }
  .hospitality-services h2 { margin: 18px 0 20px; font: 500 clamp(34px, 4vw, 54px)/1.08 var(--display); letter-spacing: -.065em; }
  .hospitality-services h2 em { font-family: Georgia, serif; font-weight: 400; }
  .hospitality-services-copy > p { max-width: 680px; color: #55635b; font-size: 16px; line-height: 1.65; }
  .hospitality-services .button { margin-top: 15px; }
  .hospitality-service-list { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line); }
  .hospitality-service-list li { padding: 13px 0; border-bottom: 1px solid var(--line); color: #48534e; font-size: 15px; line-height: 1.55; }
  @media (max-width: 760px) { .hospitality-profile-mark { width: min(270px, 82%); } .hospitality-profile { width: min(186px, 56vw); height: 270px; } .hospitality-profile figcaption { right: -5px; } .hospitality-services { grid-template-columns: 1fr; gap: 30px; } }
</style>
