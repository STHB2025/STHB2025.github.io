---
import BaseLayout from '../components/BaseLayout.astro';
import ProjectArtwork from '../components/ProjectArtwork.astro';
import { profile, education } from '../data/site';
---
<BaseLayout title="About Jackson — Business, technology and service" description={profile.bio} active="/about/">
  <section class="page-hero about-hero"><div class="page-hero-copy"><span class="eyebrow">ABOUT · A PRACTICE BUILT AROUND PEOPLE</span><h1>People first.<br/><em>Practical always.</em></h1><p>{profile.bio} His work brings together business development, technology, hospitality and community impact.</p></div><div class="about-art"><ProjectArtwork kind="arno" /></div><div class="page-hero-index">CAPE TOWN<br/>SOUTH AFRICA</div></section>
  <section class="section about-story"><div class="eyebrow">THE THROUGH-LINE</div><div><h2>Service taught me<br/><em>how business feels.</em></h2><p>Hospitality taught Jackson operations, service, people management and customer experience. Business development applies those skills to partnerships, markets and commercial opportunities. Technology provides tools for solving practical problems and building systems that can grow. Community projects apply the same principles to digital inclusion and trust.</p><p class="pull-note">Practical over theoretical. Human-centred. Trust before scale.</p></div></section>
  <section class="about-principles"><div class="section-heading"><div><span class="eyebrow">WORKING PHILOSOPHY</span><h2>Make it useful.<br/><em>Make it human.</em></h2></div><span class="principle-mark">J<span>.</span></span></div><div class="principle-list"><div><b>01</b><span>People before process</span><p>Start with what people need and what helps them move forward.</p></div><div><b>02</b><span>Practical over theoretical</span><p>Useful actions, plain language and clear next steps.</p></div><div><b>03</b><span>Trust before scale</span><p>Build confidence into the relationship before expanding the system.</p></div><div><b>04</b><span>Partnership over silos</span><p>Connect the people, resources and opportunities needed to execute.</p></div></div></section>
  <section class="section education-section"><div><span class="eyebrow">LEARNING & DEVELOPMENT</span><h2>Learning that<br/><em>keeps moving.</em></h2></div><ul class="education-list">{education.map((item, i) => <li><span>0{i + 1}</span>{item}</li>)}</ul></section>
</BaseLayout>
