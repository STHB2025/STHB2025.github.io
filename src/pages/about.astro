---
import BaseLayout from '../components/BaseLayout.astro';
import ProjectArtwork from '../components/ProjectArtwork.astro';
import { profile, education } from '../data/site';
---
<BaseLayout title="About Jackson — Business, Technology & Hospitality" description={profile.bio} active="/about/">
  <section class="page-hero about-hero"><div class="page-hero-copy"><span class="eyebrow">ABOUT · A MULTI-DISCIPLINARY PRACTICE</span><h1>People first.<br/><em>Practical always.</em></h1><p>{profile.bio}</p><a class="button button-dark about-cta" href="/contact/">Discuss an opportunity <span>↗</span></a></div><div class="about-art about-portrait"><img src="/images/jackson/portrait.webp" alt="Portrait of Innocent Jackson wearing a navy suit and glasses" loading="eager" decoding="async" /><span class="about-portrait-name">{profile.fullName}</span></div><div class="page-hero-index">CAPE TOWN<br/>SOUTH AFRICA</div></section>
  <section class="section about-story"><div class="eyebrow">THE THROUGH-LINE</div><div><h2>Service taught me<br/><em>how business feels.</em></h2><p>My hospitality experience taught me about operations, service, people and customer experience. Business development has strengthened how I think about relationships and practical opportunities. I bring those perspectives into website work: listen first, make information clear, and help visitors find the next step.</p><p class="pull-note">Practical over theoretical. Human-centred. Trust before scale.</p></div></section>
  <section class="about-principles"><div class="section-heading"><div><span class="eyebrow">WORKING PHILOSOPHY</span><h2>Make it useful.<br/><em>Make it human.</em></h2></div><span class="principle-mark">J<span>.</span></span></div><div class="principle-list"><div><b>01</b><span>People before process</span><p>Start with what people need and what helps them move forward.</p></div><div><b>02</b><span>Practical over theoretical</span><p>Useful actions, plain language and clear next steps.</p></div><div><b>03</b><span>Trust before scale</span><p>Build confidence into the relationship before expanding the system.</p></div><div><b>04</b><span>Partnership over silos</span><p>Connect the people, resources and opportunities needed to execute.</p></div></div></section>
  <section class="section education-section"><div><span class="eyebrow">LEARNING & DEVELOPMENT</span><h2>Learning that<br/><em>keeps moving.</em></h2></div><ul class="education-list">{education.map((item, i) => <li><span>0{i + 1}</span>{item}</li>)}</ul></section>
</BaseLayout>

<style>
  .about-portrait { display: grid; place-items: end center; isolation: isolate; overflow: hidden; border: 1px solid rgba(125, 211, 238, .34); border-radius: 50% 50% 20px 20px; background: radial-gradient(ellipse at 50% 75%, rgba(14, 90, 167, .74), rgba(11, 37, 69, .96) 58%, #07182e 100%); box-shadow: 0 24px 60px rgba(7, 24, 46, .2); }
  .about-portrait::before, .about-portrait::after { content: ''; position: absolute; z-index: -1; left: 50%; top: 48%; aspect-ratio: 1; border-radius: 50%; transform: translate(-50%, -50%); }
  .about-portrait::before { width: min(76%, 292px); background: radial-gradient(circle at 50% 45%, rgba(28, 111, 180, .42), rgba(11, 37, 69, .16) 70%); box-shadow: 0 24px 55px rgba(0, 0, 0, .18); }
  .about-portrait::after { width: min(84%, 324px); border: 1px solid rgba(125, 211, 238, .42); }
  .about-portrait img { display: block; width: min(91%, 348px); height: 100%; object-fit: contain; object-position: center bottom; filter: drop-shadow(0 12px 16px rgba(0, 0, 0, .3)); }
  .about-portrait-name { position: absolute; z-index: 2; left: 50%; bottom: 13px; transform: translateX(-50%); max-width: calc(100% - 24px); padding: 7px 11px; border: 1px solid rgba(125, 211, 238, .34); background: rgba(7, 24, 46, .82); color: #f4f1eb; font: 9px var(--mono); letter-spacing: .09em; text-align: center; white-space: nowrap; }
  @media (max-width: 760px) { .about-portrait::before { width: min(72vw, 258px); } .about-portrait::after { width: min(80vw, 288px); } .about-portrait img { width: min(88vw, 320px); } }
</style>
