---
import BaseLayout from '../../components/BaseLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import projects from '../../data/projects.json';
import { sitePath } from '../../utils/site-path';
const categoryGroups = [
  { id: 'website-development', title: 'Website Development', description: 'Website work for a founder-led digital learning initiative and a client service business.' },
  { id: 'technology-education', title: 'Technology and Education', description: 'Digital learning and practical education work.' },
  { id: 'business-development', title: 'Business Development', description: 'Ventures and concepts focused on service development, brand growth and partnerships.' },
  { id: 'prototypes-experiments', title: 'Prototypes and Experiments', description: 'Early-stage concepts and demonstrations, clearly identified by their current status.' },
];
---
<BaseLayout title="Selected Work — Jackson Portfolio" description="Explore website development, technology and education, business-development, and prototype projects by Jackson in Cape Town, South Africa." active="/work/">
  <section class="page-hero work-hero"><div class="page-hero-copy"><span class="eyebrow">SELECTED WORK · WEB & BUSINESS PROJECTS</span><h1>Work that<br/><em>connects the dots.</em></h1><p>Browse eight projects by the kind of work they represent. The two website projects lead; other work shows the wider technology, education and business-development practice.</p><div class="work-hero-actions"><a class="button button-dark" href="#website-development">Explore website work <span>↓</span></a><a class="quiet-link" href={sitePath('/design-and-digital/')}>See design samples <span>↗</span></a><a class="quiet-link" href={sitePath('/contact/')}>Discuss an opportunity <span>↗</span></a></div></div><div class="work-index-art"><span>2024—<br/>PRESENT</span><i>PEOPLE<br/>→ IDEAS<br/>→ ACTION</i></div></section>
  <section class="section work-listing" id="selected-work"><div class="work-filters"><span>PROJECT CATEGORIES</span><span>{projects.length} ENTRIES</span><span class="filters-note">Select a category to jump to its projects.</span></div><nav class="work-category-nav" aria-label="Project categories"><ul>{categoryGroups.map((group) => <li><a href={`#${group.id}`}>{group.title}<span aria-hidden="true">↘</span></a></li>)}</ul></nav>
    {categoryGroups.map((group) => {
      const groupProjects = projects.filter((project) => project.portfolioCategory === group.id);
      return <section class="work-category" id={group.id} aria-labelledby={`${group.id}-title`}><header class="work-category-heading"><div><span class="eyebrow">{String(categoryGroups.indexOf(group) + 1).padStart(2, '0')} / {groupProjects.length} PROJECT{groupProjects.length === 1 ? '' : 'S'}</span><h2 id={`${group.id}-title`}>{group.title}</h2><p>{group.description}</p></div><a class="text-link" href="#selected-work">Back to categories <i>↑</i></a></header><div class="project-grid">{groupProjects.map((project, i) => <ProjectCard project={project} index={i + 1} />)}</div></section>;
    })}
  </section>
</BaseLayout>

<style>
  .work-hero-actions { display: flex; align-items: center; gap: 24px; margin-top: 28px; flex-wrap: wrap; }
  .work-hero-actions .button { min-width: 222px; }
  .work-hero-actions .quiet-link span { padding-left: 7px; color: var(--orange); }
  .work-category-nav { margin: 0 0 65px; }
  .work-category-nav ul { display: flex; flex-wrap: wrap; gap: 9px; list-style: none; margin: 0; padding: 0; }
  .work-category-nav a { display: inline-flex; align-items: center; gap: 13px; padding: 10px 14px; border: 1px solid var(--line); background: rgba(255,255,255,.24); font-size: 11px; }
  .work-category-nav a:hover, .work-category-nav a:focus-visible { border-color: var(--green); color: var(--green); }
  .work-category-nav a span { color: var(--orange); }
  .work-category { scroll-margin-top: 24px; margin-top: 75px; }
  .work-category:first-of-type { margin-top: 0; }
  .work-category-heading { display: flex; justify-content: space-between; align-items: end; gap: 24px; margin-bottom: 32px; }
  .work-category-heading h2 { margin: 12px 0 8px; font: 500 clamp(30px, 3.5vw, 46px)/1.1 var(--display); letter-spacing: -.06em; }
  .work-category-heading p { max-width: 560px; margin: 0; color: #59665f; font-size: 13px; }
  .work-category-heading > a { flex: 0 0 auto; margin-bottom: 4px; }
  .work-category .project-grid { row-gap: 40px; }
  @media (max-width: 760px) { .work-category { margin-top: 55px; } .work-category-nav { margin-bottom: 45px; } .work-category-heading { display: block; } .work-category-heading > a { display: inline-block; margin-top: 16px; } }
</style>
