---
import BaseLayout from '../components/BaseLayout.astro';
import ProjectArtwork from '../components/ProjectArtwork.astro';
import HomepagePortfolioSections from '../components/HomepagePortfolioSections.astro';
import WebDevelopmentOffer from '../components/WebDevelopmentOffer.astro';
import projects from '../data/projects.json';
import { profile } from '../data/site';
import { sitePath } from '../utils/site-path';
const featured = projects.filter((project) => ['senior-tech-hub', 'dazzle-home-services'].includes(project.slug));
---
<BaseLayout title="Jackson | Business Development, Technology & Web Design" description="Jackson is a business development professional, entrepreneur and technology enthusiast in Cape Town, bringing together web development, brand support, partnerships and hospitality experience.">
  <section class="hero home-hero">
    <div class="hero-copy"><p class="eyebrow"><span class="eyebrow-dot"></span> JACKSON · CAPE TOWN, SOUTH AFRICA</p><h1>Building Businesses.<br/><em>Connecting Technology.</em><br/>Creating Opportunities.</h1><p class="hero-position">I work across business development, entrepreneurship, technology and hospitality, turning ideas into practical services, business initiatives and digital solutions.</p><p class="hero-offer"><strong>For small businesses:</strong> website design and development is my primary commercial service, supported by practical digital and brand help.</p><div class="hero-actions"><a class="button button-dark" href={sitePath('/contact/#project-enquiry')}>Request a Project Consultation <span>↗</span></a><a class="quiet-link" href={sitePath('/contact/#professional-opportunities')}>Discuss an Opportunity <span>↘</span></a></div><div class="hero-projects" aria-label="Featured website projects"><span>PROJECT WORK</span><div>{featured.filter((project) => project.brandLogo).map((project) => <a href={sitePath(`/work/${project.slug}/`)} aria-label={`Explore ${project.title}`}><img src={sitePath(project.brandLogo.src)} alt={project.brandLogo.alt} /></a>)}</div></div></div>
    <div class="hero-art-wrap"><ProjectArtwork kind="hub" /><span class="hero-art-caption">CLEAR WEBSITES,<br/>BUILT AROUND PEOPLE.</span><span class="hero-orbit-note">CAPE TOWN<br/>WORKING ACROSS SOUTH AFRICA</span></div>
    <div class="hero-bottom"><span>SCROLL TO DISCOVER</span><span class="scroll-rule"></span><span>BUSINESS · TECHNOLOGY · SERVICE</span></div>
  </section>
  <section class="intro-band"><span class="eyebrow">WEBSITE DESIGN & DEVELOPMENT</span><p>A professional website should make it easy for customers to <strong>understand your services and take the next step.</strong></p><a href="#web-services" class="round-arrow" aria-label="Explore web development services">↘</a></section>
  <WebDevelopmentOffer />
  <section class="complementary-work" aria-labelledby="complementary-title"><div><span class="eyebrow">COMPLEMENTARY CAPABILITIES</span><h2 id="complementary-title">Support around<br/><em>the main offer.</em></h2><p>Depending on the project, I can also contribute practical support in these areas.</p></div><ul><li><b>Brand development & promotional design</b><span>Clearer visual communication for a business or initiative.</span></li><li><b>Digital business support</b><span>Practical help with online presence and customer pathways.</span></li><li><b>Business development & partnerships</b><span>Relationship building, opportunity development and collaboration.</span></li><li><b>Practical technology & AI solutions</b><span>Exploration and implementation shaped around a real need.</span></li></ul></section>
  <HomepagePortfolioSections />
  <section class="home-bridge"><div class="bridge-visual"><ProjectArtwork kind="wall" /></div><div class="bridge-copy"><span class="eyebrow">A SERVICE-FIRST APPROACH</span><h2>Good websites<br/><em>start with listening.</em></h2><p>More than 16 years across hospitality and operations shaped how I think about trust, clear communication and the small details that make an experience work.</p><a class="text-link" href={sitePath('/about/')}>Learn about my approach <i>↗</i></a></div></section>
  <section class="home-pathways" aria-label="Choose how to connect"><article><span class="eyebrow">FOR BUSINESSES</span><h2>Have a project<br/><em>to move forward?</em></h2><p>For website development, branding, digital support and business growth projects.</p><a class="button button-dark" href={sitePath('/contact/#project-enquiry')}>Request a Project Consultation <span>↗</span></a></article><article id="professional-opportunities"><span class="eyebrow">FOR PROFESSIONAL OPPORTUNITIES</span><h2>Let’s discuss<br/><em>what could connect.</em></h2><p>For employment, strategic partnerships, technology initiatives, collaborations and community-impact opportunities.</p><a class="button button-light" href={`mailto:${profile.email}?subject=${encodeURIComponent('Professional opportunity')}`}>Discuss an Opportunity <span>↗</span></a></article></section>
</BaseLayout>

<style>
  .home-work-links { display: flex; align-items: center; gap: 24px; flex-wrap: wrap; }
  @media (max-width: 760px) { .home-work-links { gap: 18px; } }
</style>

<style>
  .hero-position { max-width: 590px; }
  .hero-offer { max-width: 570px; margin: 15px 0 0; color: #59665f; font-size: 15px; line-height: 1.65; }
  .hero-offer strong { color: #182a28; }
  .home-hero .hero-actions { flex-wrap: wrap; gap: 14px 22px; }
  .complementary-work { display: grid; grid-template-columns: .8fr 1.2fr; gap: clamp(32px, 7vw, 96px); padding: clamp(58px, 8vw, 104px) var(--pad); background: #f4f1eb; }
  .complementary-work h2, .home-pathways h2 { margin: 14px 0; font: 500 clamp(30px, 3.7vw, 48px)/1.08 var(--display); letter-spacing: -.06em; }
  .complementary-work h2 em, .home-pathways h2 em { font-family: Georgia, serif; font-weight: 400; }
  .complementary-work > div > p, .home-pathways article > p { max-width: 420px; color: #59665f; font-size: 15px; line-height: 1.65; }
  .complementary-work ul { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line); }
  .complementary-work li { display: grid; gap: 5px; padding: 15px 0; border-bottom: 1px solid var(--line); }
  .complementary-work li b { font-size: 15px; font-weight: 600; }
  .complementary-work li span { color: #59665f; font-size: 14px; line-height: 1.55; }
  .home-pathways { display: grid; grid-template-columns: 1fr 1fr; gap: 1px; padding: 1px var(--pad); background: #d4d0c7; }
  .home-pathways article { padding: clamp(28px, 5vw, 64px); background: #ebe7df; }
  .home-pathways article:nth-child(2) { background: #182a28; color: #f4f1eb; }
  .home-pathways article:nth-child(2) .eyebrow { color: #bbc5b8; }
  .home-pathways article:nth-child(2) > p { color: #d0d6ce; }
  .button-light { display: inline-flex; align-items: center; gap: 14px; padding: 13px 18px; background: #f4f1eb; color: #182a28; font-size: 12px; font-weight: 650; transition: background-color .18s ease; }
  .button-light:hover, .button-light:focus-visible { background: #fff; }
  .home-hero .button, .home-pathways .button { max-width: 100%; gap: 16px; }
  @media (max-width: 760px) { .home-hero .hero-actions { align-items: flex-start; flex-direction: column; } .complementary-work { grid-template-columns: 1fr; gap: 26px; } .home-pathways { grid-template-columns: 1fr; } .home-pathways article { padding: 28px 20px; } }
</style>

<style>
  .hero-projects { display: flex; align-items: center; gap: 13px; margin-top: 18px; }
  .hero-projects>span { font: 10px var(--mono); letter-spacing: .1em; color: #59665f; white-space: nowrap; }
  .hero-projects>div { display: flex; gap: 7px; }
  .hero-projects a { width: 45px; height: 38px; display: grid; place-items: center; padding: 4px; background: #fff; border: 1px solid rgba(24,42,40,.08); }
  .hero-projects img { display: block; max-width: 100%; max-height: 100%; object-fit: contain; }
  .project-disclosure { margin: 32px 0 0; color: #59665f; font-size: 12px; }
  @media (max-width: 760px) { .hero-projects { gap: 9px; margin-top: 14px; } .hero-projects>div { gap: 6px; } .hero-projects a { width: 42px; height: 36px; } .project-disclosure { margin-top: 22px; line-height: 1.6; } }
</style>

<style>
  .home-hero h1 { max-width: 780px; font-size: clamp(38px, 4.5vw, 64px); }
  @media (max-width: 760px) { .home-hero h1 { font-size: clamp(36px, 8vw, 53px); } }
</style>
