---
import BaseLayout from '../components/BaseLayout.astro';
import ProjectArtwork from '../components/ProjectArtwork.astro';
import ProjectCard from '../components/ProjectCard.astro';
import projects from '../data/projects.json';
import { profile } from '../data/site';
const featured = projects.filter((p) => p.featured).slice(0, 5);
---
<BaseLayout title="Jackson — Building businesses, connecting technology" description={profile.headline}>
  <section class="hero home-hero">
    <div class="hero-copy"><p class="eyebrow"><span class="eyebrow-dot"></span> JACKSON · CAPE TOWN, SOUTH AFRICA</p><h1>Building businesses,<br/><em>connecting technology,</em><br/>and creating practical impact.</h1><p class="hero-position">Business Development <b>•</b> Technology <b>•</b> Hospitality <b>•</b> Entrepreneurship</p><div class="hero-actions"><a class="button button-dark" href="/work/">Explore the work <span>↘</span></a><a class="quiet-link" href="/about/">A little about me <span>↗</span></a></div></div>
    <div class="hero-art-wrap"><ProjectArtwork kind="hub" /><span class="hero-art-caption">PATIENT TECHNOLOGY SUPPORT,<br/>BUILT AROUND PEOPLE.</span><span class="hero-orbit-note">01 — 03<br/>A HUMAN-CENTRED PRACTICE</span></div>
    <div class="hero-bottom"><span>SCROLL TO DISCOVER</span><span class="scroll-rule"></span><span>01 / 06</span></div>
  </section>
  <section class="intro-band"><span class="eyebrow">THE THREAD THROUGH THE WORK</span><p>From the floor of a hotel to the edge of a new idea — <strong>good work starts by understanding people.</strong></p><a href="/about/" class="round-arrow" aria-label="Read about Jackson">↘</a></section>
  <section class="section work-section"><div class="section-heading"><div><span class="eyebrow">SELECTED WORK · 2024—NOW</span><h2>Ideas with<br/><em>something behind them.</em></h2></div><a href="/work/" class="text-link">View all work <i>↗</i></a></div><div class="project-grid home-project-grid">{featured.map((project, i) => <ProjectCard project={project} index={i + 1} />)}</div></section>
  <section class="home-bridge"><div class="bridge-visual"><ProjectArtwork kind="wall" /></div><div class="bridge-copy"><span class="eyebrow">THE FOUNDATION</span><h2>Service is a<br/><em>serious business.</em></h2><p>More than 16 years across hospitality and operations shaped how I think about trust, clear communication and the small details that make an experience work.</p><a class="text-link" href="/hospitality/">Explore my hospitality experience <i>↗</i></a></div></section>
  <section class="belief-band"><div class="belief-number">01—04</div><blockquote>“Technology should improve everyday life — and people should feel confident using it.”</blockquote><span>THE PRINCIPLE BEHIND THE PRACTICE</span></section>
  <section class="home-close"><span class="eyebrow">GOOD WORK STARTS WITH A CONVERSATION</span><h2>Have a practical<br/><em>challenge in mind?</em></h2><a class="button button-dark" href="/contact/">Get in touch <span>↗</span></a></section>
</BaseLayout>
