---
import BaseLayout from '../components/BaseLayout.astro';
import ProjectArtwork from '../components/ProjectArtwork.astro';
import ProjectCard from '../components/ProjectCard.astro';
import WebDevelopmentOffer from '../components/WebDevelopmentOffer.astro';
import projects from '../data/projects.json';
import { profile } from '../data/site';
const featured = projects.filter((project) => ['senior-tech-hub', 'dazzle-home-services'].includes(project.slug));
---
<BaseLayout title="Jackson | Business, Technology & Hospitality" description={profile.headline}>
  <section class="hero home-hero">
    <div class="hero-copy"><p class="eyebrow"><span class="eyebrow-dot"></span> BUSINESS DEVELOPMENT · TECHNOLOGY · HOSPITALITY</p><h1>Building businesses,<br/><em>connecting technology,</em><br/>creating practical impact.</h1><p class="hero-position">I bring together entrepreneurship, digital development, hospitality and customer experience to turn useful ideas into practical work.</p><div class="hero-actions"><a class="button button-dark" href="#featured-websites">Explore my work <span>↘</span></a><a class="quiet-link" href="/contact/">Discuss an opportunity <span>↗</span></a></div><div class="hero-projects" aria-label="Featured website projects"><span>SELECTED WORK</span><div>{featured.filter((project) => project.brandLogo).map((project) => <a href={`/work/${project.slug}/`} aria-label={`Explore ${project.title}`}><img src={project.brandLogo.src} alt={project.brandLogo.alt} /></a>)}</div></div></div>
    <div class="hero-art-wrap"><ProjectArtwork kind="hub" /><span class="hero-art-caption">CLEAR WEBSITES,<br/>BUILT AROUND PEOPLE.</span><span class="hero-orbit-note">CAPE TOWN<br/>WORKING ACROSS SOUTH AFRICA</span></div>
    <div class="hero-bottom"><span>SCROLL TO DISCOVER</span><span class="scroll-rule"></span><span>BUSINESS · TECHNOLOGY · SERVICE</span></div>
  </section>
  <section class="intro-band"><span class="eyebrow">WEBSITE DESIGN & DEVELOPMENT</span><p>A professional website should make it easy for customers to <strong>understand your services and take the next step.</strong></p><a href="#web-services" class="round-arrow" aria-label="Explore web development services">↘</a></section>
  <WebDevelopmentOffer />
  <section class="section work-section" id="featured-websites"><div class="section-heading"><div><span class="eyebrow">SELECTED WEBSITE PROJECTS</span><h2>Two businesses.<br/><em>Two different goals.</em></h2></div><div class="home-work-links"><a href="/work/" class="text-link">Explore all projects <i>↗</i></a><a href="/contact/" class="text-link">Request a quote <i>↗</i></a></div></div><div class="project-grid home-project-grid">{featured.map((project, i) => <ProjectCard project={project} index={i + 1} />)}</div><p class="project-disclosure">Senior Tech Hub is a personal project. Dazzle Home Services is client business work.</p></section>
  <section class="home-bridge"><div class="bridge-visual"><ProjectArtwork kind="wall" /></div><div class="bridge-copy"><span class="eyebrow">A SERVICE-FIRST APPROACH</span><h2>Good websites<br/><em>start with listening.</em></h2><p>More than 16 years across hospitality and operations shaped how I think about trust, clear communication and the small details that make an experience work.</p><a class="text-link" href="/about/">Learn about my approach <i>↗</i></a></div></section>
  <section class="belief-band"><div class="belief-number">01—05</div><blockquote>“A website should make the business easier to understand — for you and for your customers.”</blockquote><span>THE PRINCIPLE BEHIND THE WORK</span></section>
  <section class="home-close"><span class="eyebrow">LET’S TALK ABOUT WHAT’S NEXT</span><h2>Have an idea,<br/><em>project or opportunity?</em></h2><a class="button button-dark" href="/contact/">Get in touch <span>↗</span></a><a class="home-close-email" href={`mailto:${profile.email}`}>{profile.email}</a></section>
</BaseLayout>

<style>
  .home-work-links { display: flex; align-items: center; gap: 24px; flex-wrap: wrap; }
  @media (max-width: 760px) { .home-work-links { gap: 18px; } }
</style>

<style>
  .home-hero h1 { font-size: clamp(44px, 5.1vw, 72px); }
  .hero-projects { display: flex; align-items: center; gap: 13px; margin-top: 18px; }
  .hero-projects>span { font: 8px var(--mono); letter-spacing: .1em; color: #68716b; white-space: nowrap; }
  .hero-projects>div { display: flex; gap: 7px; }
  .hero-projects a { width: 45px; height: 38px; display: grid; place-items: center; padding: 4px; background: #fff; border: 1px solid rgba(24,42,40,.08); }
  .hero-projects img { display: block; max-width: 100%; max-height: 100%; object-fit: contain; }
  .project-disclosure { margin: 32px 0 0; color: #59665f; font-size: 12px; }
  .home-close-email { display: block; width: fit-content; margin: 18px auto 0; color: #59665f; font-size: 12px; text-decoration: underline; text-underline-offset: 4px; }
  @media (max-width: 760px) { .home-hero h1 { font-size: clamp(38px, 10.5vw, 50px); } .hero-projects { gap: 9px; margin-top: 14px; } .hero-projects>div { gap: 6px; } .hero-projects a { width: 42px; height: 36px; } .project-disclosure { margin-top: 22px; line-height: 1.6; } }
</style>
