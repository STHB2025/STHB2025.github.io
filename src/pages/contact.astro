---
import BaseLayout from '../components/BaseLayout.astro';
import { profile } from '../data/site';
---
<BaseLayout title="Contact Jackson" description="Contact Jackson about business development, technology, hospitality and partnership opportunities." active="/contact/">
  <section class="contact-page"><div class="contact-copy"><span class="eyebrow"><span class="eyebrow-dot"></span> CONTACT · CAPE TOWN, SOUTH AFRICA</span><h1>Let’s start<br/><em>with a conversation.</em></h1><p>For business development, partnerships, digital inclusion, hospitality and practical technology opportunities.</p><a class="button button-dark" href={`mailto:${profile.email}`}>Email Jackson <span>↗</span></a></div><div class="contact-details"><span class="eyebrow">DIRECT DETAILS</span><a href={`mailto:${profile.email}`}><small>PROFESSIONAL EMAIL</small>{profile.email}<i>↗</i></a><a href={profile.linkedin} target="_blank" rel="noopener noreferrer"><small>LINKEDIN</small>Innocent Jackson<i>↗</i></a></div><div class="contact-side-note">GOOD WORK<br/>STARTS WITH<br/>GOOD QUESTIONS.</div></section>
</BaseLayout>
