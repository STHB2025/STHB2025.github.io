---
import BaseLayout from '../components/BaseLayout.astro';
import { profile } from '../data/site';
const professionalEnquiry = `mailto:${profile.email}?subject=${encodeURIComponent('Professional enquiry')}&body=${encodeURIComponent('Hi Jackson,\n\nI would like to discuss a professional opportunity.\n\nArea of interest (business, technology, hospitality or web development):\nA few details:\n\nThank you.')}`;
const whatsappEnquiry = `https://wa.me/${profile.whatsapp.replace(/\D/g, '')}?text=${encodeURIComponent('Hi Jackson, I would like to discuss a professional opportunity.')}`;
---
<BaseLayout title="Contact Jackson — Cape Town" description="Contact Jackson about business, technology, hospitality, web development or professional opportunities." active="/contact/">
  <section class="contact-page"><div class="contact-copy"><span class="eyebrow"><span class="eyebrow-dot"></span> PROFESSIONAL ENQUIRIES · CAPE TOWN, SOUTH AFRICA</span><h1>Let’s talk<br/><em>about what’s next.</em></h1><p>Get in touch about business development, technology, hospitality, web development or another professional opportunity. Share a little context and I’ll reply so we can discuss a suitable next step.</p><a class="button button-dark" href={professionalEnquiry}>Contact Me <span>↗</span></a><p class="contact-note">The email button opens a draft in your email app. No enquiry form is connected on this site.</p></div><div class="contact-details"><span class="eyebrow">CHOOSE HOW TO GET IN TOUCH</span><a href={professionalEnquiry}><small>EMAIL</small>{profile.email}<i>↗</i></a><a href={whatsappEnquiry} target="_blank" rel="noopener noreferrer"><small>WHATSAPP · PROFESSIONAL MOBILE</small>{profile.whatsapp}<i>↗</i></a><a href={profile.linkedin} target="_blank" rel="noopener noreferrer"><small>LINKEDIN</small>Innocent Jackson<i>↗</i></a></div><div class="contact-side-note">GOOD WORK<br/>STARTS WITH<br/>GOOD QUESTIONS.</div></section>
</BaseLayout>

<style>
  .contact-note { max-width: 400px; margin-top: 16px; color: #68716b; font-size: 11px; }
  .contact-details > a { line-height: 1.6; }
</style>
