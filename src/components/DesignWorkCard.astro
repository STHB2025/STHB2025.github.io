---
const { item, project } = Astro.props;
const externalLinks = item.links ?? [item.sample];
---
<article class="design-card">
  <a class:list={['design-card-image', item.imageFit === 'contain' && 'design-card-image-contained']} href={`/work/${project.slug}/`} aria-label={`Open ${project.title} case study`}>
    <img src={item.preview.src} alt={item.preview.alt} loading="lazy" decoding="async" />
    {item.brandMark && <span class="design-card-brand"><img src={item.brandMark.src} alt={item.brandMark.alt} loading="lazy" decoding="async" /></span>}
    {item.founderPortrait && <span class="design-card-founder"><img src={item.founderPortrait.src} alt={item.founderPortrait.alt} loading="lazy" decoding="async" /></span>}
    <span class="design-card-index">{item.discipline}</span>
  </a>
  <div class="design-card-copy">
    <p class="design-card-kicker">{project.title}</p>
    <h2>{item.title}</h2>
    <p class="design-card-description">{item.description}</p>
    <div class="design-card-links">
      {externalLinks.filter(Boolean).map((link) => <a class="text-link" href={link.href} target="_blank" rel="noopener noreferrer">{link.label} <i>↗</i></a>)}
      <a class="design-case-link" href={`/work/${project.slug}/`}>Project context <span>↗</span></a>
    </div>
  </div>
</article>

<style>
  .design-card { display: grid; grid-template-columns: 1.05fr .95fr; align-items: center; gap: clamp(24px, 5vw, 70px); padding: 0 0 48px; border-bottom: 1px solid var(--line); }
  .design-card + .design-card { padding-top: 48px; }
  .design-card:nth-child(even) .design-card-image { order: 2; }
  .design-card-image { position: relative; display: block; min-height: 290px; aspect-ratio: 1.32; overflow: hidden; background: #e8e5dd; }
  .design-card-image img { display: block; width: 100%; height: 100%; min-height: 290px; object-fit: cover; transition: transform .5s ease; }
  .design-card-image-contained { display: grid; place-items: center; padding: clamp(18px, 4vw, 42px); background: radial-gradient(ellipse at 50% 48%, #f8f7f3, #e4e0d6); }
  .design-card-image-contained > img:first-child { width: 100%; height: 100%; min-height: 0; object-fit: contain; }
  .design-card-image .design-card-brand { position: absolute; top: 16px; left: 16px; width: clamp(76px, 11vw, 112px); aspect-ratio: 1; display: grid; place-items: center; padding: 5px; overflow: hidden; border: 1px solid rgba(255,255,255,.8); border-radius: 50%; background: #07152b; box-shadow: 0 8px 24px rgba(4, 13, 29, .24); }
  .design-card-image .design-card-brand img { display: block; width: 100%; height: 100%; min-height: 0; object-fit: cover; border-radius: 50%; }
  .design-card-image .design-card-founder { position: absolute; right: clamp(16px, 3vw, 34px); bottom: 20px; width: clamp(98px, 15vw, 150px); aspect-ratio: 1; display: grid; place-items: center; overflow: hidden; border: 3px solid rgba(125, 211, 238, .9); border-radius: 50%; background: #0b2545; box-shadow: 0 10px 28px rgba(7, 24, 46, .42); }
  .design-card-image .design-card-founder img { display: block; width: 100%; height: 100%; min-height: 0; object-fit: cover; object-position: center 20%; border-radius: 50%; }
  .design-card-image:hover > img:first-child { transform: scale(1.025); }
  .design-card-index { position: absolute; left: 14px; bottom: 14px; padding: 8px 10px; background: rgba(244, 241, 235, .94); color: var(--ink); font: 9px var(--mono); letter-spacing: .08em; }
  .design-card-copy { max-width: 480px; }
  .design-card-kicker { margin: 0 0 16px; color: #68736b; text-transform: uppercase; font: 9px var(--mono); letter-spacing: .1em; }
  .design-card-copy h2 { margin: 0 0 14px; font: 500 clamp(26px, 3.3vw, 42px)/1.12 var(--display); letter-spacing: -.055em; }
  .design-card-description { max-width: 430px; color: #59665f; font-size: 14px; }
  .design-card-links { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 20px; margin-top: 23px; }
  .design-case-link { color: #59665f; font-size: 12px; font-weight: 650; }
  .design-case-link span { padding-left: 6px; color: var(--orange); }
  .design-card a:focus-visible { outline: 3px solid var(--orange); outline-offset: 4px; }
  @media (max-width: 760px) {
    .design-card, .design-card:nth-child(even) { grid-template-columns: 1fr; gap: 22px; padding-bottom: 32px; }
    .design-card + .design-card { padding-top: 32px; }
    .design-card:nth-child(even) .design-card-image { order: 0; }
    .design-card-image, .design-card-image img { min-height: 245px; }
    .design-card-image .design-card-brand { top: 12px; left: 12px; width: 76px; }
    .design-card-image .design-card-founder { right: 16px; bottom: 16px; width: 104px; }
    .design-card-copy h2 { font-size: 30px; }
  }
  @media (prefers-reduced-motion: reduce) { .design-card-image img { transition: none; } }
</style>
