---
import ProjectCard from './ProjectCard.astro';
import projects from '../data/projects.json';
import { sitePath } from '../utils/site-path';

const bySlug = (slug) => projects.find((project) => project.slug === slug);
const templates = ['beauty-wellness-template', 'plumbing-home-services-template'].map(bySlug).filter(Boolean);
const ventures = ['the-wall-fitter', 'arno-deep', 'dazzle-home-services'].map(bySlug).filter(Boolean);
const concepts = ['trade-procurement', 'trustbridge-africa-korea'].map(bySlug).filter(Boolean);
const payguard = bySlug('payguard-prototype');
const community = ['senior-tech-hub', 'tech-tips-africa'].map(bySlug).filter(Boolean);
---

<section class="home-section template-section" id="website-demonstrations" aria-labelledby="templates-title">
  <div class="home-section-head">
    <div><span class="eyebrow">WEBSITE DESIGN · LIVE DEMONSTRATIONS</span><h2 id="templates-title">Industry-ready ideas,<br/><em>made tangible.</em></h2></div>
    <p>Reusable website demonstrations show how a small business can present its services, build trust and help customers make an enquiry. Demonstration business details are samples.</p>
  </div>
  <div class="template-grid">
    {templates.map((project, index) => <article class="template-item">
      <ProjectCard project={project} index={index + 1} />
      <div class="template-actions"><span>LIVE DEMONSTRATION · SAMPLE BUSINESS</span><a href={project.liveUrl} target="_blank" rel="noopener noreferrer">View demonstration <i>↗</i></a></div>
    </article>)}
  </div>
  <div class="template-next-step"><span>HAVE A BUSINESS IN MIND?</span><p>We can shape the pages and customer pathway around your actual services, branding and goals.</p><a class="text-link" href={sitePath('/contact/#project-enquiry')}>Request a Project Consultation <i>↗</i></a></div>
</section>

<slot name="after-templates" />

<section class="home-section venture-section" id="business-ventures" aria-labelledby="ventures-title">
  <div class="home-section-head">
    <div><span class="eyebrow">BUSINESS VENTURES</span><h2 id="ventures-title">Businesses &amp;<br/><em>ventures.</em></h2></div>
    <p>Building and developing businesses through strategy, brand growth, partnerships and practical execution.</p>
  </div>
  <div class="venture-list">
    {ventures.map((project, index) => <article class="venture-row">
      <span class="venture-index">0{index + 1}</span>
      <a class="venture-mark" href={sitePath(`/work/${project.slug}/`)} aria-label={`Explore ${project.title}`}>
        {project.brandLogo ? <img src={sitePath(project.brandLogo.src)} alt={project.brandLogo.alt} loading="lazy" decoding="async" /> : <span>{project.title}</span>}
      </a>
      <div class="venture-copy"><div class="venture-meta">{project.projectType && <span class="venture-project-type">{project.projectType}</span>}{project.role && <span class="venture-role">{project.role}</span>}</div><h3>{project.title}</h3><p>{project.summary}</p></div>
      <a class="venture-link" href={sitePath(`/work/${project.slug}/`)} aria-label={`Read about ${project.title}`}>↗</a>
    </article>)}
  </div>
  <div class="concept-list">{concepts.map((project) => <article class="concept-strip"><div><span class="eyebrow">DEVELOPING CONCEPT</span><h3>{project.title}</h3></div><p>{project.summary} No operating partnerships or current activity are implied.</p><a class="text-link" href={sitePath(`/work/${project.slug}/`)}>Explore the concept <i>↗</i></a></article>)}</div>
</section>

<section class="home-section prototype-section" id="prototypes" aria-labelledby="prototype-title">
  <div class="home-section-head">
    <div><span class="eyebrow">TECHNOLOGY · EARLY STAGE</span><h2 id="prototype-title">Prototypes &amp;<br/><em>experiments.</em></h2></div>
    <p>Exploring practical technology ideas, testing workflows and developing concepts around real-world challenges.</p>
  </div>
  {payguard && <article class="prototype-feature">
    <div class="prototype-visual" aria-hidden="true"><span class="prototype-kicker">PAYGUARD · PROTOTYPE</span><div class="prototype-flow"><span>Transaction</span><i>→</i><span>Risk check</span><i>→</i><span>Family review</span></div><p>SIMULATED WORKFLOW</p></div>
    <div class="prototype-copy"><div class="prototype-status"><span>PROTOTYPE</span><span>NO LIVE BANK CONNECTION</span></div><h3>{payguard.title}</h3><p>{payguard.summary}</p><p>Risk signals are simulated. Approval states are demonstrations. PayGuard is not a live financial product or payment service.</p><a class="text-link" href={sitePath(`/work/${payguard.slug}/`)}>Read about the prototype <i>↗</i></a><a class="quiet-link" href={payguard.evidence[0].href} target="_blank" rel="noopener noreferrer">View source repository <span>↗</span></a></div>
  </article>}
  <p class="future-note">Future work may explore AI tools, workflow automation, programmable banking and API integrations when there is a real, evidenced project to share.</p>
</section>

<section class="home-section community-section" id="community-impact" aria-labelledby="community-title">
  <div class="home-section-head">
    <div><span class="eyebrow">COMMUNITY · TECHNOLOGY · IMPACT</span><h2 id="community-title">Technology that<br/><em>meets people where they are.</em></h2></div>
    <p>Digital inclusion and technology education through beginner-friendly resources, community learning and practical online-safety guidance.</p>
  </div>
  <div class="community-grid">{community.map((project, index) => <ProjectCard project={project} index={index + 1} />)}</div>
  <div class="community-links"><a href="https://payhip.com/SeniorTechHub" target="_blank" rel="noopener noreferrer">Senior Tech Hub resource store <span>↗</span></a><a href={sitePath('/technology/')}>Explore technology work <span>↗</span></a><a href={sitePath('/thought-leadership/')}>Read thought leadership <span>↗</span></a></div>
</section>

<style>
  .home-section { padding: clamp(64px, 8vw, 112px) var(--pad); }
  .home-section-head { display: grid; grid-template-columns: 1fr .62fr; gap: clamp(28px, 7vw, 92px); align-items: end; margin-bottom: 40px; }
  .home-section-head h2 { margin: 14px 0 0; font: 500 clamp(34px, 4.7vw, 60px)/1.06 var(--display); letter-spacing: -.06em; }
  .home-section-head h2 em { font-family: Georgia,serif; font-weight: 400; }
  .home-section-head > p { max-width: 450px; margin: 0 0 4px; color: #59665f; font-size: 15px; line-height: 1.7; }
  .template-section { background: #f4f1eb; }
  .template-grid { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: clamp(18px,3vw,36px); }
  .template-item { min-width: 0; }
  .template-item :global(.project-card-copy) { padding-bottom: 10px; }
  .template-actions { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px; padding: 14px 0; border-top: 1px solid var(--line); }
  .template-actions > span, .template-next-step > span { color: #59665f; font: 10px var(--mono); letter-spacing: .08em; }
  .template-actions a { color: #182a28; font-size: 12px; font-weight: 600; }
  .template-actions i, .community-links span { color: var(--orange); font-style: normal; }
  .template-next-step { display: flex; justify-content: space-between; align-items: center; gap: 20px; margin-top: 38px; padding: 20px 0; border-top: 1px solid var(--line); }
  .template-next-step p { max-width: 470px; margin: 0; color: #59665f; font-size: 13px; }
  .venture-section { background: #ebe7df; }
  .concept-list { display: grid; gap: 10px; margin-top: 10px; }
  .venture-list { border-top: 1px solid #cbc7bd; }
  .venture-row { display: grid; grid-template-columns: 46px minmax(90px,150px) minmax(0,1fr) 34px; align-items: center; gap: clamp(14px,3vw,36px); padding: 20px 0; border-bottom: 1px solid #cbc7bd; }
  .venture-index { color: #a35c40; font: 11px var(--mono); }
  .venture-mark { display: grid; place-items: center; width: 100%; height: 75px; padding: 8px; background: rgba(255,255,255,.68); }
  .venture-mark img { display: block; max-width: 100%; max-height: 100%; object-fit: contain; }
  .venture-mark > span { color: #182a28; font: 600 16px var(--display); text-align: center; }
  .venture-meta { display: grid; justify-items: start; gap: 4px; color: #59665f; }
  .venture-project-type { font: 10px var(--mono); letter-spacing: .04em; text-transform: uppercase; }
  .venture-role { font-size: 12px; line-height: 1.4; }
  .venture-copy h3 { margin: 7px 0 4px; font: 600 21px/1.2 var(--display); letter-spacing: -.03em; }
  .venture-copy p { margin: 0; max-width: 660px; color: #59665f; font-size: 13px; line-height: 1.55; }
  .venture-link { display: grid; place-items: center; width: 32px; height: 32px; border: 1px solid #bbb9ae; color: #182a28; }
  .concept-strip { display: grid; grid-template-columns: minmax(200px,.8fr) 1fr auto; gap: 24px; align-items: center; margin-top: 28px; padding: 22px; background: rgba(255,255,255,.46); }
  .concept-strip h3 { margin: 8px 0 0; font: 600 17px/1.25 var(--display); }
  .concept-strip > p { max-width: 490px; margin: 0; color: #59665f; font-size: 13px; line-height: 1.6; }
  .prototype-section { background: #182a28; color: #f4f1eb; }
  .prototype-section .eyebrow { color: #bbc5b8; }
  .prototype-section .home-section-head > p { color: #d0d6ce; }
  .prototype-feature { display: grid; grid-template-columns: 1fr .9fr; min-height: 280px; background: #243a35; }
  .prototype-visual { display: flex; flex-direction: column; justify-content: center; gap: 30px; padding: clamp(24px,5vw,54px); background: radial-gradient(ellipse at 48% 55%,#36564b 0%,#243a35 70%); }
  .prototype-kicker, .prototype-visual > p { color: #c8d3c8; font: 10px var(--mono); letter-spacing: .1em; }
  .prototype-flow { display: flex; align-items: center; flex-wrap: wrap; gap: 10px; }
  .prototype-flow span { padding: 12px 14px; border: 1px solid #748579; font: 12px var(--display); }
  .prototype-flow i { color: #d28a66; font-style: normal; }
  .prototype-visual > p { margin: 0; }
  .prototype-copy { padding: clamp(24px,4vw,46px); }
  .prototype-status { display: flex; flex-wrap: wrap; gap: 8px; color: #c8d3c8; font: 10px var(--mono); letter-spacing: .06em; }
  .prototype-status span:first-child { color: #f0b091; }
  .prototype-copy h3 { margin: 17px 0 10px; font: 500 27px/1.1 var(--display); }
  .prototype-copy p { color: #d0d6ce; font-size: 13px; line-height: 1.65; }
  .prototype-copy .text-link, .prototype-copy .quiet-link { display: inline-block; margin: 8px 20px 0 0; color: #fff; }
  .prototype-copy .text-link i { color: #e9a17f; }
  .future-note { margin: 20px 0 0; color: #cbd4cc; font-size: 12px; line-height: 1.6; }
  .community-section { background: #f4f1eb; }
  .community-grid { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: clamp(18px,3vw,36px); }
  .community-links { display: flex; flex-wrap: wrap; gap: 12px 28px; margin-top: 32px; padding-top: 20px; border-top: 1px solid var(--line); }
  .community-links a { color: #182a28; font-size: 12px; font-weight: 600; }
  @media (max-width: 760px) {
    .home-section-head { grid-template-columns: 1fr; gap: 16px; margin-bottom: 28px; }
    .template-grid, .community-grid { grid-template-columns: 1fr; }
    .template-next-step { display: grid; justify-items: start; gap: 10px; }
    .venture-row { grid-template-columns: 24px 72px minmax(0,1fr) 28px; gap: 12px; }
    .venture-mark { height: 58px; padding: 5px; }
    .venture-project-type { font-size: 9px; }
    .venture-role { font-size: 11px; }
    .venture-copy h3 { font-size: 17px; }
    .venture-copy p { font-size: 12px; }
    .concept-strip { grid-template-columns: 1fr; gap: 10px; padding: 18px; }
    .prototype-feature { grid-template-columns: 1fr; }
    .prototype-flow { gap: 7px; }
    .prototype-flow span { padding: 9px; font-size: 11px; }
  }
  @media (max-width: 360px) { .venture-row { grid-template-columns: 20px 56px minmax(0,1fr) 24px; gap: 8px; } .venture-mark { height: 48px; } .venture-copy h3 { font-size: 15px; } }
</style>
