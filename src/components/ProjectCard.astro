---
import ProjectArtwork from './ProjectArtwork.astro';
import { sitePath } from '../utils/site-path';
const { project, index = 1 } = Astro.props;
---
<article class="project-card">
  <a class="project-card-link" href={sitePath(`/work/${project.slug}/`)} aria-label={`Open ${project.title} case study`}>
    <div class="project-card-art" class:list={{ 'project-card-art--contain': project.coverFit === 'contain' }}>
      {project.cover ? <img class="project-card-photo" style={`object-position: ${project.coverPosition ?? 'center'}`} src={sitePath(project.cover.src)} alt={project.cover.alt} loading="lazy" decoding="async" /> : <ProjectArtwork kind={project.visual} compact />}
      {project.brandLogo && project.brandLogoPlacement !== 'below' && <span class="project-card-brand"><img src={sitePath(project.brandLogo.src)} alt={project.brandLogo.alt} loading="lazy" decoding="async" /></span>}
      <span class="card-index">0{index}</span>
    </div>
    {project.brandLogo && project.brandLogoPlacement === 'below' && <div class="project-card-brand-row"><img src={sitePath(project.brandLogo.src)} alt={project.brandLogo.alt} loading="lazy" decoding="async" /></div>}
    <div class="project-card-copy">{project.previewLabel && <span class="project-card-preview-label">{project.previewLabel}</span>}<div class="card-kicker"><span>{project.category}</span>{project.projectType && <span class="project-type">{project.projectType}</span>}{project.status && <span class="status">{project.status}</span>}</div><h3>{project.title}</h3><p>{project.summary}</p><span class="text-link">Explore case study <i>↗</i></span></div>
  </a>
</article>

<style>
  .project-card-photo { display: block; width: 100%; height: 100%; object-fit: cover; }
  .project-card-art--contain { background: #e9e5dd; }
  .project-card-art--contain .project-card-photo { object-fit: contain; }
  .project-card-brand { position: absolute; z-index: 2; right: 18px; bottom: 18px; width: clamp(88px, 12vw, 142px); height: clamp(70px, 9vw, 108px); padding: 10px; display: grid; place-items: center; background: rgba(255,255,255,.94); box-shadow: 0 8px 28px rgba(24,42,40,.12); }
  .project-card-brand img { display: block; width: 100%; height: 100%; object-fit: contain; }
  .project-card-brand-row { min-height: 58px; padding: 8px 20px; display: flex; align-items: center; justify-content: flex-end; background: #e9e5dd; }
  .project-card-brand-row img { display: block; width: auto; max-width: 140px; height: 42px; object-fit: contain; }
  .project-card-preview-label { display: block; margin: 0 0 9px; color: #59665f; font: 10px var(--mono); letter-spacing: .045em; }
  .project-type { display: inline-flex; width: fit-content; padding: 4px 7px; border: 1px solid #d4d0c7; color: #43544a; font-size: 10px; line-height: 1.35; letter-spacing: .04em; }
  .project-card-copy .card-kicker { justify-content: flex-start; flex-wrap: wrap; gap: 7px 12px; }
  .project-card-copy .status { margin-left: auto; }
  @media (max-width: 760px) { .project-card-brand { width: 90px; height: 70px; right: 12px; bottom: 12px; } }
</style>
