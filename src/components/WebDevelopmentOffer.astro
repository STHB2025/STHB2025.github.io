---
import { webDevelopmentSteps, webServices } from '../data/site';
---

<section class="web-services" id="web-services" aria-labelledby="web-services-title">
  <div class="web-services-heading">
    <div>
      <span class="eyebrow">WEB DEVELOPMENT · SOUTH AFRICA</span>
      <h2 id="web-services-title">A clearer online<br/><em>home for your business.</em></h2>
    </div>
    <p>I create affordable, professional websites for small businesses and startups that need a clear place to explain what they do and help customers get in touch.</p>
  </div>
  <ul class="service-grid">
    {webServices.map((service) => (
      <li class="service-card">
        <span class="service-number">{service.number}</span>
        <h3>{service.title}</h3>
        <p>{service.description}</p>
      </li>
    ))}
  </ul>
  <div class="approach-panel" aria-labelledby="approach-title">
    <div class="approach-intro">
      <span class="eyebrow">A STRAIGHTFORWARD PROCESS</span>
      <h2 id="approach-title">From first conversation<br/><em>to a useful website.</em></h2>
      <a class="button button-dark" href="/contact/#project-enquiry">Request a Project Consultation <span>↗</span></a>
    </div>
    <ol class="approach-steps">
      {webDevelopmentSteps.map((step) => (
        <li><span>{step.number}</span><div><h3>{step.title}</h3><p>{step.description}</p></div></li>
      ))}
    </ol>
  </div>
</section>

<style>
  .web-services { padding: clamp(72px, 9vw, 130px) var(--pad); background: #ebe7df; }
  .web-services-heading { display: grid; grid-template-columns: 1.25fr .75fr; align-items: end; gap: clamp(28px, 7vw, 100px); margin-bottom: 44px; }
  .web-services-heading h2, .approach-intro h2 { margin: 18px 0 0; font: 500 clamp(35px, 4.8vw, 62px)/1.08 var(--display); letter-spacing: -.065em; }
  .web-services-heading h2 em, .approach-intro h2 em { font-family: Georgia, serif; font-weight: 400; }
  .web-services-heading > p { max-width: 440px; margin: 0 0 5px; color: #59665f; font-size: 15px; }
  .service-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); list-style: none; gap: 1px; margin: 0; padding: 1px; background: #d4d0c7; border: 1px solid #d4d0c7; }
  .service-card { min-height: 188px; padding: 22px; background: #f4f1eb; }
  .service-number, .approach-steps > li > span { color: #b75c3d; font: 10px var(--mono); letter-spacing: .08em; }
  .service-card h3 { margin: 28px 0 8px; font: 600 17px/1.25 var(--display); letter-spacing: -.02em; }
  .service-card p, .approach-steps p { margin: 0; color: #59665f; font-size: 12px; line-height: 1.6; }
  .approach-panel { display: grid; grid-template-columns: .8fr 1.2fr; gap: clamp(35px, 8vw, 112px); margin-top: clamp(70px, 9vw, 118px); padding: clamp(28px, 5vw, 60px); background: #182a28; color: #f4f1eb; }
  .approach-intro .eyebrow { color: #bbc5b8; }
  .approach-intro h2 { font-size: clamp(31px, 3.7vw, 48px); }
  .approach-intro .text-link { display: inline-block; margin-top: 28px; color: #fff; }
  .approach-intro .button { margin-top: 28px; }
  .approach-steps { list-style: none; display: grid; gap: 0; margin: 0; padding: 0; }
  .approach-steps > li { display: grid; grid-template-columns: 40px 1fr; gap: 15px; padding: 15px 0; border-bottom: 1px solid #526259; }
  .approach-steps > li:first-child { padding-top: 0; }
  .approach-steps > li:last-child { border-bottom: 0; padding-bottom: 0; }
  .approach-steps h3 { margin: 0 0 4px; color: #fff; font-size: 15px; }
  .approach-steps p { color: #d0d6ce; }
  @media (max-width: 900px) { .service-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } .approach-panel { grid-template-columns: 1fr 1.2fr; gap: 35px; } }
  @media (max-width: 640px) { .web-services-heading, .approach-panel { grid-template-columns: 1fr; } .web-services-heading { gap: 17px; margin-bottom: 28px; } .service-grid { grid-template-columns: 1fr; } .service-card { min-height: 0; padding: 19px; } .service-card h3 { margin-top: 16px; } .approach-panel { padding: 26px 20px; gap: 35px; } }
</style>
